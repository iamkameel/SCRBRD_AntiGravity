rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// SCRBRD Firestore Security Rules
//
// Two things to understand before editing:
//
// 1. EVERY WRITE IS SERVER-SIDE. All mutations go through Next.js server
//    actions that call requireUser() (src/lib/auth/session.ts) and then write
//    with the Firebase Admin SDK, which bypasses these rules entirely.
//    So the client write rule is `false` everywhere — if a feature needs to
//    write, it gets a guarded server action, not a rule exception.
//
// 2. ROLES COME FROM A CUSTOM CLAIM, not a document read. The claim is set at
//    sign-in (api/auth/session) from users/{uid}.role. Reading a document to
//    resolve a role costs a read on every rule evaluation and can be
//    circumvented if that document is client-writable; the claim is neither.
//
// Tiers mirror src/lib/auth/rbac.ts:
//   1 platform · 2 competition · 3 school · 4 coaching/ops · 5 participant · 6 external
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Identity ──────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() ? request.auth.token.get('role', 'external') : 'external';
    }

    function tier() {
      return role() in ['superadmin', 'platformops'] ? 1
           : role() in ['leagueadmin', 'tournamentdirector'] ? 2
           : role() in ['sportsmaster', 'schooladmin', 'medicalofficer', 'schoolstaff'] ? 3
           : role() in ['coach', 'coachsupport', 'matchofficial', 'groundskeeper', 'driver', 'selector'] ? 4
           : role() in ['player', 'adultplayer', 'parent'] ? 5
           : 6;
    }

    /** Signed in and at or above the given tier (lower number = more access). */
    function atLeast(t) {
      return isSignedIn() && tier() <= t;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ─── Accounts ──────────────────────────────────────────────────────────
    // A user may read their own record. Nobody writes from the client: the
    // role field lives here and is the source of the custom claim, so a
    // client write would be privilege escalation.

    match /users/{uid} {
      allow read: if isSelf(uid) || atLeast(2);
      allow write: if false;
    }

    // ─── People and squads ─────────────────────────────────────────────────

    match /people/{personId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if false;
      match /{sub=**} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /rosters/{rosterId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Competition structure (reference data) ────────────────────────────

    match /schools/{schoolId}      { allow read: if isSignedIn(); allow write: if false; }
    match /seasons/{seasonId}      { allow read: if isSignedIn(); allow write: if false; }
    match /divisions/{divisionId}  { allow read: if isSignedIn(); allow write: if false; }
    match /leagues/{leagueId}      { allow read: if isSignedIn(); allow write: if false; }
    match /invitations/{inviteId}  { allow read: if atLeast(3);   allow write: if false; }

    // ─── Matches ───────────────────────────────────────────────────────────
    // Live score and ball log are readable by any signed-in user (spectators
    // follow along); team selections are embargoed until released.

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /live/{docId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /scoring_actions/{actionId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // Tactical directives are captain/coach comms, not spectator content.
      match /tacticalDirectives/{directiveId} {
        allow read: if atLeast(4);
        allow write: if false;
        match /{sub=**} {
          allow read: if atLeast(4);
          allow write: if false;
        }
      }

      match /impact_events/{eventId} {
        allow read: if atLeast(4);
        allow write: if false;
        match /{sub=**} {
          allow read: if atLeast(4);
          allow write: if false;
        }
      }

      match /player_impact/{personId} {
        allow read: if atLeast(4);
        allow write: if false;
      }
    }

    match /match_scoring_locks/{matchId} { allow read: if atLeast(4); allow write: if false; }
    match /match_highlights/{highlightId} { allow read: if isSignedIn(); allow write: if false; }
    match /field_sport_matches/{matchId} { allow read: if isSignedIn(); allow write: if false; }
    match /fixture_readiness_checks/{checkId} { allow read: if atLeast(4); allow write: if false; }

    // ─── Development and assessment ────────────────────────────────────────
    // Coaching data. A player's own view of their ratings is served by a
    // server action, not a client read: personId is a person-record id and
    // does not equal the Firebase uid, so there is no self-read rule here.
    match /skill_assessments/{assessmentId} {
      allow read: if atLeast(4);
      allow write: if false;
    }

    match /performance_indices/{indexId}  { allow read: if atLeast(4); allow write: if false; }
    match /development_trends/{trendId}   { allow read: if atLeast(4); allow write: if false; }
    match /readiness_scores/{scoreId}     { allow read: if atLeast(4); allow write: if false; }
    match /coach_interventions/{id}       { allow read: if atLeast(4); allow write: if false; }

    // ─── Medical — confidential ────────────────────────────────────────────

    match /medical_incidents/{incidentId}      { allow read: if atLeast(3); allow write: if false; }
    match /concussion_rtp_records/{recordId}   { allow read: if atLeast(3); allow write: if false; }

    // ─── Scouting — restricted, and never visible to the subject ───────────

    match /scouting_reports/{reportId}    { allow read: if atLeast(3); allow write: if false; }
    match /scouting_watchlists/{listId}   { allow read: if atLeast(3); allow write: if false; }
    match /provincial_invitationals/{id}  { allow read: if atLeast(3); allow write: if false; }

    // ─── Recognition ───────────────────────────────────────────────────────

    match /awards/{awardId}         { allow read: if isSignedIn(); allow write: if false; }
    match /accolades/{accoladeId}   { allow read: if isSignedIn(); allow write: if false; }
    match /honours/{honourId}       { allow read: if isSignedIn(); allow write: if false; }
    match /milestones/{milestoneId} { allow read: if isSignedIn(); allow write: if false; }

    // Wallets and ledger are written by the rewards engine and read through
    // server actions only — no client access at all.
    match /rewards_wallets/{playerId}     { allow read, write: if false; }
    match /reward_transactions/{txId}     { allow read, write: if false; }

    // ─── Facilities and logistics ──────────────────────────────────────────

    match /fields/{fieldId} {
      allow read: if isSignedIn();
      allow write: if false;
      match /{sub=**} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /facility_bookings/{bookingId}  { allow read: if atLeast(4); allow write: if false; }
    match /ground_status_logs/{logId}     { allow read: if isSignedIn(); allow write: if false; }
    match /maintenance_tasks/{taskId}     { allow read: if atLeast(4); allow write: if false; }
    match /equipment/{itemId}             { allow read: if atLeast(4); allow write: if false; }

    match /vehicles/{vehicleId}           { allow read: if atLeast(4); allow write: if false; }
    match /transport_trips/{tripId}       { allow read: if atLeast(4); allow write: if false; }
    match /trip_passengers/{passengerId}  { allow read: if atLeast(4); allow write: if false; }

    // ─── Community and communications ──────────────────────────────────────

    match /community_rsvps/{rsvpId}            { allow read: if isSignedIn(); allow write: if false; }
    match /community_notif_prefs/{studentId}   { allow read: if atLeast(5); allow write: if false; }
    match /parent_notifications/{notifId}      { allow read: if isSignedIn(); allow write: if false; }
    match /staff_broadcasts/{broadcastId}      { allow read: if atLeast(4); allow write: if false; }
    match /child_profiles/{profileId}          { allow read: if atLeast(3); allow write: if false; }

    // ─── Finance and audit — administrative only ───────────────────────────

    match /transactions/{transactionId} { allow read: if atLeast(3); allow write: if false; }
    match /receipts/{receiptId}         { allow read: if atLeast(3); allow write: if false; }
    match /audit_logs/{logId}           { allow read: if atLeast(2); allow write: if false; }

    // ─── Default deny ──────────────────────────────────────────────────────
    // Anything not named above is unreachable from the client. Adding a
    // collection means adding a rule here deliberately, not inheriting access.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
