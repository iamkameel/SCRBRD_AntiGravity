rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function userData() {
      return get(/databases/$(database)/documents/people/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && role in userData().roles;
    }

    function isSystemArchitect() {
      return hasRole('System Architect');
    }

    function isAdmin() {
      return hasRole('Admin') || isSystemArchitect();
    }

    function isSportsmaster() {
      return hasRole('Sportsmaster') || isAdmin();
    }

    function isHeadCoach() {
      return hasRole('Head Coach') || isSportsmaster();
    }

    function isCoach() {
      return hasRole('Assistant Coach') || hasRole('Coach') || isHeadCoach();
    }

    function isCaptain() {
      return hasRole('Captain') || isCoach();
    }

    function isScorer() {
      return hasRole('Scorer') || isAdmin();
    }

    function isUmpire() {
      return hasRole('Umpire') || isAdmin();
    }

    function isMedical() {
      return hasRole('Medical Staff') || isAdmin();
    }

    function isGroundskeeper() {
      return hasRole('Groundskeeper') || isSportsmaster();
    }

    function isTransport() {
      return hasRole('Transport Coordinator') || isSportsmaster();
    }

    function canScore() {
      return isScorer() || isUmpire();
    }

    function canManageData() {
      return isSportsmaster();
    }

    // ─── People ─────────────────────────────────────────────────────────────

    match /people/{personId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(personId) || canManageData() || isCoach();
      allow delete: if isAdmin();
    }

    // ─── Core Entities ───────────────────────────────────────────────────────

    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }

    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }

    match /divisions/{divisionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }

    match /venues/{venueId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }

    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }

    // ─── Teams & Rosters ─────────────────────────────────────────────────────

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();

      match /roster/{rosterId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isCoach();
      }

      match /squads/{squadId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isCoach();
      }
    }

    // ─── Competitions & Fixtures ──────────────────────────────────────────────

    match /competitions/{competitionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }

    match /fixtures/{fixtureId} {
      allow read: if isSignedIn();
      allow create, delete: if canManageData();
      // Updates are broad — specific sub-collections restrict further.
      allow update: if isSignedIn();

      match /officials/{officialId} {
        allow read: if isSignedIn();
        allow create, delete: if canManageData();
        allow update: if canManageData()
          || isOwner(get(/databases/$(database)/documents/fixtures/$(fixtureId)/officials/$(officialId)).data.personId);
      }

      match /lineups/{teamId} {
        allow read: if isSignedIn();
        allow create, update: if isCoach() || canManageData();
      }

      match /scorecards/{inningsId} {
        allow read: if isSignedIn();
        allow create, update, delete: if canScore();
      }

      match /transportAssignments/{assignmentId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isTransport() || canManageData();
      }

      match /readinessChecks/{checkId} {
        allow read: if isSignedIn();
        allow create, update: if canManageData() || isCoach();
      }

      match /availabilityResponses/{responseId} {
        allow read: if isCoach() || canManageData();
        allow create, update: if isSignedIn();
      }
    }

    // ─── Scoring (Ball Events) ────────────────────────────────────────────────

    match /ballEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canScore();
    }

    match /innings/{inningsId} {
      allow read: if isSignedIn();
      allow create, update: if canScore();
    }

    match /scoringLocks/{fixtureId} {
      // Session lock for multi-scorer handover
      allow read: if isSignedIn();
      allow create, update, delete: if canScore();
    }

    // ─── Tactical Directive Bus ───────────────────────────────────────────────
    // Note: there is no top-level `match /matches/{matchId}` rule block in this
    // file — live-scoring writes go through the Admin SDK (matchActions.ts),
    // which bypasses rules entirely, and client reads of `matches` are
    // apparently ungated today. That's a pre-existing gap, out of scope here.
    // This block only secures the tacticalDirectives subtree, which IS read
    // and written directly from the client (Coach/Captain Cockpit listeners),
    // so it needs its own rules regardless of the parent collection's state.

    match /matches/{matchId}/tacticalDirectives/{directiveId} {
      allow read: if isSignedIn() && (
        resource.data.issuedByPersonId == request.auth.uid ||
        resource.data.issuedToPersonId == request.auth.uid ||
        isCoach() || isAdmin()
      );
      allow create: if isSignedIn() && isCoach()
        && request.resource.data.issuedByPersonId == request.auth.uid;
      // Only the issuing coach may mutate the directive itself (supersede/
      // cancel/expire/denormalized latestResponse). Captain input always goes
      // through the responses subcollection instead — the directive record
      // stays an immutable statement of original intent.
      allow update: if isSignedIn() && (
        resource.data.issuedByPersonId == request.auth.uid || isCoach()
      );
      allow delete: if false;

      match /responses/{responseId} {
        allow read: if isSignedIn() && (isCoach() || isCaptain());
        // clientEventId is the doc id, so a retried submit overwrites its own
        // response rather than creating a duplicate — the captain who typed
        // it is the only one who can ever write that id.
        allow create: if isSignedIn() && isCaptain()
          && request.resource.data.respondedByPersonId == request.auth.uid;
        allow update, delete: if false;
      }

      match /receipts/{personId} {
        allow read: if isSignedIn() && (isCoach() || request.auth.uid == personId);
        allow write: if isSignedIn() && request.auth.uid == personId;
      }

      match /outcomes/{deliveryId} {
        allow read: if isSignedIn() && (isCoach() || isCaptain() || isScorer());
        allow create, update: if isSignedIn() && (isScorer() || isCoach());
        allow delete: if false;
      }
    }

    // ─── Player Development ───────────────────────────────────────────────────

    match /skillMatrices/{matrixId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCoach();

      match /assessments/{assessmentId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isCoach();
      }
    }

    match /performanceIndices/{indexId} {
      allow read: if isSignedIn();
      allow create, update: if isCoach();
    }

    match /developmentTrends/{trendId} {
      allow read: if isSignedIn();
      allow create, update: if isCoach();
    }

    match /developmentNeeds/{needId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCoach();
    }

    match /drillRecommendations/{recommendationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCoach();
    }

    // ─── Drills & Training ────────────────────────────────────────────────────

    match /drills/{drillId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCoach();
    }

    match /trainingSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCoach();

      match /assignments/{assignmentId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isCoach();
      }

      match /logs/{logId} {
        allow read: if isSignedIn();
        allow create, update: if isCoach();
      }
    }

    match /trainingPlans/{planId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCoach();
    }

    // ─── Medical ──────────────────────────────────────────────────────────────

    match /injuryRecords/{recordId} {
      allow read: if isMedical() || isCoach();
      allow create, update, delete: if isMedical();
    }

    match /medicalNotes/{noteId} {
      // Medical notes are sensitive — restricted to medical staff and admins
      allow read, create, update, delete: if isMedical();
    }

    match /readinessScores/{scoreId} {
      allow read: if isCoach() || isMedical() || canManageData();
      allow create, update: if isCoach() || isMedical();
    }

    // ─── Facilities & Grounds ─────────────────────────────────────────────────

    match /fields/{fieldId} {
      allow read: if isSignedIn();
      allow create, update: if isGroundskeeper();
      allow delete: if canManageData();

      match /bookings/{bookingId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isGroundskeeper() || canManageData();
      }

      match /statusLogs/{logId} {
        allow read: if isSignedIn();
        allow create, update: if isGroundskeeper();
      }

      match /maintenanceTasks/{taskId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isGroundskeeper();
      }
    }

    // ─── Transport ────────────────────────────────────────────────────────────

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTransport();
    }

    match /transportTrips/{tripId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTransport();

      match /passengers/{passengerId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isTransport();
      }
    }

    // ─── Awards, Accolades, Milestones ────────────────────────────────────────

    match /awards/{awardId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCoach() || canManageData();
    }

    match /accolades/{accoladeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isCoach();
    }

    match /milestones/{milestoneId} {
      allow read: if isSignedIn();
      allow create, update: if isCoach() || canManageData();
    }

    // ─── Scouting ─────────────────────────────────────────────────────────────

    match /scoutingReports/{reportId} {
      allow read: if isCoach() || canManageData();
      allow create, update: if isCoach();
      allow delete: if isAdmin();
    }

    match /scoutingWatchlists/{watchlistId} {
      allow read: if isCoach() || canManageData();
      allow create, update, delete: if isCoach();
    }

    // ─── Rankings ─────────────────────────────────────────────────────────────

    match /playerRankings/{rankingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /teamRankings/{rankingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ─── Notifications ────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.recipientId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.recipientId);
      allow delete: if isOwner(resource.data.recipientId) || isAdmin();
    }

    // ─── Financials (Restricted) ──────────────────────────────────────────────

    match /financials/{transactionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /equipment/{itemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }

    match /sponsors/{sponsorId} {
      allow read: if isSignedIn();
      allow create, update, delete: if canManageData();
    }

    // ─── Audit Log (Append-only) ──────────────────────────────────────────────

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // Any signed-in action may create a log
      allow update, delete: if false; // Immutable
    }

    // ─── Family Links ─────────────────────────────────────────────────────────

    match /familyLinks/{linkId} {
      allow read: if isSignedIn();
      allow create, delete: if isOwner(resource.data.guardianId) || isAdmin();
    }
  }
}
